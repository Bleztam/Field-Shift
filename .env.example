# Google Gemini API key — multimodal NLU, explanation writing, fallback TTS
GEMINI_API_KEY=

# Addis AI API key — TTS for am/om/ti/sid/wal (server-side, never expose to client)
ADDIS_API_KEY=

# Addis AI voice overrides per language (optional). When unset, the first
# voice returned by GET /api/v1/voice/voices?language=<code> is used.
# Amharic keeps its historical default "am-hamen" (or legacy ADDIS_VOICE_ID).
ADDIS_VOICE_ID=am-hamen
ADDIS_VOICE_ID_AM=
ADDIS_VOICE_ID_OM=
ADDIS_VOICE_ID_TI=
ADDIS_VOICE_ID_SID=
ADDIS_VOICE_ID_WAL=

# (Optional) Backend base URL for native mobile APK builds
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
