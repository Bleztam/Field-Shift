# Google Gemini API key — multimodal NLU, explanation writing, fallback TTS
GEMINI_API_KEY=

# Addis AI API key — Amharic TTS only (server-side, never expose to client)
ADDIS_API_KEY=

# Addis AI voice: "am-hamen" (default) or "am-simon"
ADDIS_VOICE_ID=am-hamen

# (Optional) Backend base URL for native mobile APK builds
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
